generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id
  login        String       @unique
  passwordHash String
  role         String       @default("player")
  displayName  String       @default("")
  avatar       String       @default("")
  createdAt    DateTime     @default(now())
  ownedMasters Master[]     @relation("MasterOwner")
  gameAccess   GameAccess[]
}

model Master {
  id          String       @id @default(uuid())
  ownerId     String
  name        String
  description String?
  mode        String       @default("development")
  createdAt   DateTime     @default(now())
  owner       User         @relation("MasterOwner", fields: [ownerId], references: [id])
  access      GameAccess[]
  activeGame  ActiveGame[]
}

model GameAccess {
  id        String   @id @default(uuid())
  userId    String
  masterId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  master    Master   @relation(fields: [masterId], references: [id])

  @@unique([userId, masterId])
}

model ActiveGame {
  id              String @id @default("singleton")
  currentMasterId String
  master          Master @relation(fields: [currentMasterId], references: [id])
}
