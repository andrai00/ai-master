generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id
  login        String       @unique
  passwordHash String
  role         String       @default("player")
  displayName  String       @default("")
  avatar       String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  ownedMasters Master[]     @relation("MasterOwner")
  gameAccess   GameAccess[]
  messages     Message[]
  sessions     Session[]    @relation("SessionPlayer")
}

model Master {
  id          String       @id @default(uuid())
  ownerId     String
  name        String
  description String?
  mode        String       @default("development")
  createdAt   DateTime     @default(now())
  owner       User         @relation("MasterOwner", fields: [ownerId], references: [id])
  access      GameAccess[]
  activeGame  ActiveGame[]
  sessions    Session[]
  documents   Document[]
  thoughtLogs ThoughtLog[]
}

model GameAccess {
  id        String   @id @default(uuid())
  userId    String
  masterId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([userId, masterId])
}

model ActiveGame {
  id              String @id @default("singleton")
  currentMasterId String
  master          Master @relation(fields: [currentMasterId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid())
  masterId    String
  title       String
  type        String   @default("note")
  category    String   @default("glossary")
  visibility  String   @default("public")
  playerId    String?
  tags        String   @default("[]")
  section     String?
  order       Int      @default(0)
  summary     String?
  content     String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  master      Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model Session {
  id          String    @id @default(uuid())
  masterId    String
  type        String    // "game" | "personal" | "builder"
  playerId    String?
  name        String
  builderMode String    @default("brain") // "brain" | "memory" (builder sessions only)
  createdAt   DateTime  @default(now())
  master      Master    @relation(fields: [masterId], references: [id], onDelete: Cascade)
  player      User?     @relation("SessionPlayer", fields: [playerId], references: [id])
  messages    Message[]
}

model Message {
  id         String   @id @default(uuid())
  sessionId  String
  senderId   String
  role       String   // "admin" | "player" | "master" | "builder"
  content    String
  shared     Boolean  @default(false)
  summarized Boolean  @default(false)
  hasFiles   Boolean  @default(false)
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])
}

model ThoughtLog {
  id        String   @id @default(uuid())
  masterId  String
  agent     String   // "builder" | "master"
  content   String
  createdAt DateTime @default(now())
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id           String  @id @default("singleton")
  provider     String  @default("custom")     // "openrouter" | "openai" | "anthropic" | "groq" | "ollama" | "custom"
  baseUrl      String  @default("")            // custom endpoint
  apiKey       String  @default("")            // encrypted or plain
  model        String  @default("")            // selected model ID
  contextLimit Int     @default(0)             // max context tokens (0 = auto-detect)
  extra        String  @default("")            // JSON: additional models list
}

model BuilderJob {
  id         String   @id @default(uuid())
  sessionId  String
  status     String   @default("pending")  // pending | processing | done | failed
  input      String                        // JSON: { content, fileIds }
  error      String?                       // error message if failed
  retries    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}
