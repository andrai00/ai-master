generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id
  login        String   @unique
  passwordHash String
  role         String   @default("player")
  displayName  String   @default("")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
}
