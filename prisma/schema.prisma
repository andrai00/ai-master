generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id
  login        String       @unique
  passwordHash String
  role         String       @default("player")
  displayName  String       @default("")
  avatar       String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  ownedMasters Master[]     @relation("MasterOwner")
  gameAccess   GameAccess[]
  documentAccess DocumentAccess[]
  messages     Message[]
  sessions     Session[]    @relation("SessionPlayer")
}

model Master {
  id          String       @id @default(uuid())
  ownerId     String
  name        String
  description String?
  mode        String       @default("development")
  createdAt   DateTime     @default(now())
  owner       User         @relation("MasterOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  access      GameAccess[]
  activeGame  ActiveGame[]
  sessions    Session[]
  documents     Document[]
  uploadedFiles UploadedFile[]
  chatSummaries ChatSummary[]
}

model GameAccess {
  id        String   @id @default(uuid())
  userId    String
  masterId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([userId, masterId])
}

model ActiveGame {
  id              String @id @default("singleton")
  currentMasterId String
  master          Master @relation(fields: [currentMasterId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid())
  masterId    String
  title       String
  path        String?               // unique "file path" per game (glossary/..., brain/..., hidden/..., visible/...)
  type        String   @default("note")
  category    String   @default("glossary")
  visibility  String   @default("public")
  playerId    String?
  tags        String   @default("[]")
  section     String?
  order       Int      @default(0)
  summary     String?
  content     String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  master      Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  access      DocumentAccess[]

  @@unique([masterId, path])
}

model Session {
  id          String    @id @default(uuid())
  masterId    String
  type        String    // "game" | "personal" | "builder"
  playerId    String?
  name        String
  builderMode String    @default("brain") // "brain" | "memory" (builder sessions only)
  createdAt   DateTime  @default(now())
  master      Master    @relation(fields: [masterId], references: [id], onDelete: Cascade)
  player      User?     @relation("SessionPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  messages    Message[]
  rolls       Roll[]
}

model Message {
  id            String   @id @default(uuid())
  sessionId     String
  senderId      String
  role          String   // "admin" | "player" | "master" | "builder"
  content       String
  shared        Boolean  @default(false)
  summarized    Boolean  @default(false)
  hasFiles      Boolean  @default(false)
  attachedFiles String   @default("[]")  // JSON: [{fileId: string, filename: string}]
  runId         String?  // id of the agent run this message belongs to
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId, runId])
}

// Full per-run transcript of an agent: user text, tool calls, tool results,
// and final text — reconstructed into the model context on each turn (like
// Claude Code's JSONL session transcripts). Only for agent internals; the
// chat UI shows Message rows only.
model AgentTranscript {
  id         String   @id @default(uuid())
  sessionId  String
  runId      String              // groups all rows of one run
  seq        Int                 // order of rows within the session
  kind       String              // "user" | "text" | "tool-call" | "tool-result"
  toolName   String?             // tool-call only
  toolCallId String?             // pairs tool-call <-> tool-result
  args       String?             // tool-call input (JSON)
  result     String?             // tool-result output
  content    String?             // user / text content
  messageId  String?             // link to Message for user/final rows
  status     String   @default("done") // "done" | "aborted"
  summarized Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([sessionId, seq])
  @@index([sessionId, runId])
  @@index([sessionId, summarized])
}

// Journal of documents the agent already read in a session — a compact hint
// injected into the context after compression ("you read X, changed: yes/no").
// It is NOT the storage of studied content (that lives in AgentTranscript).
model DocumentRead {
  id         String   @id @default(uuid())
  sessionId  String
  documentId String
  readAt     DateTime @default(now())
  runId      String?  // run that last read/wrote the doc; used to evict reads after summarization

  @@unique([sessionId, documentId])
  @@index([sessionId])
  @@index([runId])
}

model UploadedFile {
  id        String   @id @default(uuid())
  masterId  String
  filename  String
  text      String
  size      Int
  path      String   @default("")
  status    String   @default("pending") // pending | ready | error
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id           String  @id @default("singleton")
  provider     String  @default("custom")     // "openrouter" | "openai" | "anthropic" | "groq" | "ollama" | "custom"
  baseUrl      String  @default("")            // custom endpoint
  apiKey       String  @default("")            // encrypted or plain
  model        String  @default("")            // selected model ID
  contextLimit Int     @default(0)             // max context tokens (0 = auto-detect)
  extra        String  @default("")            // JSON: additional models list
}

model BuilderJob {
  id         String   @id @default(uuid())
  sessionId  String
  status     String   @default("pending")  // pending | processing | done | failed
  input      String                        // JSON: { content, fileIds }
  error      String?                       // error message if failed
  retries    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}

model ChatSummary {
  id        String   @id @default(uuid())
  masterId  String
  content   String             // accumulated summary text
  preview   String   @default("")  // latest preview
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model DocumentAccess {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
}

model Roll {
  id              String   @id @default(uuid())
  sessionId       String
  playerId        String?
  checkName       String
  diceExpression  String
  count           Int      @default(1)
  status          String   @default("assigned")
  consumed        Boolean  @default(false)
  result          String?
  detail          String?
  assignedBy      String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([sessionId, playerId])
}

model TraceEvent {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  chat         String // "game" | "personal" | "builder"
  sessionId    String
  phase        String // "exec" | "retry" | "study"
  stepIndex    Int?
  toolName     String? // tool call (null for prompts and final replies)
  args         String? // tool arguments (JSON)
  result       String? // tool result (JSON) or final reply text
  prompt       String? // full system+messages prompt for the pass (JSON)
  elapsedMs    Int?
  error        String?
  finishReason String?

  @@index([chat, createdAt])
  @@index([sessionId, createdAt])
}
