# ─────────────────────────────────────────────────────────────────────────────
# ai-master — пример .env
# Скопируй в .env и заполни под свой запуск. Файл .env не коммитится.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# База данных (Prisma + SQLite)
# ─────────────────────────────────────────────────────────────────────────────

# Путь к SQLite-базе — относительно корня проекта.
# Приложение НЕ читает этот путь из .env: в коде (src/shared/lib/db/prisma.ts)
# жёстко прописан data/ai-master.db. DATABASE_URL используется Prisma CLI
# (db push, db execute) и схемой — поэтому должен совпадать с реальным файлом.
# Формат: file:./data/ai-master.db
DATABASE_URL="file:./data/ai-master.db"

# ─────────────────────────────────────────────────────────────────────────────
# Авторизация
# ─────────────────────────────────────────────────────────────────────────────

# Секрет для подписи JWT-токена сессии (обязательно задай свой, не дефолтный!).
# Если не задан — используется запасной "ai-master-dev-secret-change-in-production".
# JWT_SECRET="какой-то-длинный-случайный-секрет"

# Флаг Secure на cookie сессии (session_token).
#  - По умолчанию Secure=false — кука отправляется и по HTTP и по HTTPS.
#    Нужно для игры по обычному HTTP через LAN/Hamachi
#    (как Foundry VTT): игроки заходят на http://<твой-hamachi-ip>:3015.
#  - COOKIE_SECURE=true → кука ТОЛЬКО по HTTPS (+ http://localhost):
#    браузер не отправит её по HTTP на IP. Для HTTPS-игры не обязателен —
#    включай только если хочешь запретить вход по HTTP (усиление безопасности).
# COOKIE_SECURE=true

# Диагностика агентов: пишет каждый промт, тул-вызов (аргументы) и ответ
# нейронки в таблицу TraceEvent (см. схему Prisma). Для анализа и оптимизации
# промтов. Потом можно дропнуть таблицу. Значения: 1 — включить, пусто — выкл.
# AGENT_TRACE=1

# Дебаг-режим агентов: показывает внутренности (тул-вызовы с аргументами и
# результатами, живой текст) прямо в чате под сообщениями агента и вживую
# во время генерации. Только для админа. Значения: 1 — включить, пусто — выкл.
# AGENT_DEBUG=1

# Показывать имена бросков мастера (checkName: «Атака», «Урон» и т.д.) в игровом
# чате. По умолчанию скрыто — в ленте только «Мастер: результат», детали и имя
# броска не видны. Временный флаг для отладки/проверки. Значения: 1 — включить,
# пусто — выкл. После включения перезапусти dev-сервер.
# SHOW_MASTER_ROLL_NAMES=1
